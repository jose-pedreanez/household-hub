{
  "id": "c9ea5ae1a09d4ff2",
  "name": "Household Hub · Inventory alerts",
  "active": false,
  "nodes": [
    {
      "id": "05c171ad-352f-4de3-a1f8-26f393b05ed6",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ],
      "parameters": {
        "content": "## Inventory alerts\nDaily 08:00. The hub reports expiring, expired and below-minimum items. An unchanged alert is not repeated within `alerts.repeatAfterHours` (config/household.yaml), so this stays quiet unless something changed.",
        "height": 200,
        "width": 520
      }
    },
    {
      "id": "a0685ca3-7412-4add-a806-7e8eaf6a4037",
      "name": "Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "94e786db-1c00-4f8c-aa65-b4db8a81bc16",
      "name": "Check inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://hub:3000/api/automation/alerts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "hubApiToken",
          "name": "Household Hub API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "46923bc8-d7fc-4ee1-a04a-0fa3814ca64f",
      "name": "Anything new?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1810c63-3a51-4760-a866-bc047b83d948",
              "leftValue": "={{ $json.message }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "2b64f805-cc13-4816-a8ad-ae5c249c028e",
      "name": "Send push notification (optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -120
      ],
      "disabled": true,
      "notes": "Replace <your-private-topic> with your own ntfy topic, or swap this node for Email/Slack. The message is also in the hub's notification feed.",
      "parameters": {
        "method": "POST",
        "url": "https://ntfy.sh/<your-private-topic>",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Title",
              "value": "Kitchen check"
            },
            {
              "name": "Click",
              "value": "={{ $json.link || '' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "={{ $json.message }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Daily 08:00": {
      "main": [
        [
          {
            "node": "Check inventory",
