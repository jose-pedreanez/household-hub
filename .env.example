# Household Hub environment template.
# Copy to .env (scripts/bootstrap.sh does this and generates the random secrets for you).
# Never commit .env. Values marked <PLACEHOLDER> must be replaced or left empty.

# ---- General ---------------------------------------------------------------
TZ=America/Los_Angeles
GROCY_CURRENCY=USD

# LAN address that phones use to reach the hub (IP or local DNS name).
# WSL2 with networkingMode=mirrored shares the Windows LAN IP.
HUB_HOSTNAME=192.168.1.105
PUBLIC_BASE_URL=https://192.168.1.105
MEALIE_PUBLIC_URL=https://192.168.1.105:9443
# Interface Caddy binds on the host. 0.0.0.0 = LAN-reachable; 127.0.0.1 = this machine only.
LAN_BIND=0.0.0.0

# ---- Household Hub (Next.js) -----------------------------------------------
# Shared household passphrase for the web login (generated by bootstrap).
HUB_PASSWORD=<GENERATED>
# Cookie signing secret (generated by bootstrap; 32+ random bytes, base64).
HUB_SESSION_SECRET=<GENERATED>
# Bearer token for automation clients (n8n). Generated by bootstrap.
HUB_API_TOKEN=<GENERATED>
# Open Food Facts asks every client to identify itself with a contact address.
OFF_USER_AGENT=HouseholdHub/0.1 (<CONTACT_EMAIL>)

# ---- Grocy -----------------------------------------------------------------
# Created by bootstrap via Grocy's own API-key screen. Server-side only.
GROCY_API_KEY=
# Replaces Grocy's default admin/admin password during bootstrap (generated).
GROCY_ADMIN_PASSWORD=<GENERATED>

# ---- Mealie ----------------------------------------------------------------
# Long-lived API token created by bootstrap. Server-side only.
MEALIE_API_TOKEN=
# Admin account bootstrap creates/updates (replaces changeme@example.com / MyPassword).
MEALIE_ADMIN_EMAIL=admin@household.local
MEALIE_ADMIN_PASSWORD=<GENERATED>
# Mealie shopping list that Grocy-Mealie Sync maintains from Grocy low stock (created by bootstrap).
MEALIE_NEEDS_LIST_ID=

# ---- Grocy-Mealie Sync -----------------------------------------------------
GMS_AUTH_SECRET=<GENERATED>

# ---- n8n -------------------------------------------------------------------
# Encrypts n8n credentials. Keep it with your backups: without it restored credentials are unreadable.
N8N_ENCRYPTION_KEY=<GENERATED>

# ---- Cloud AI (optional) ---------------------------------------------------
# anthropic | openai | none. With "none" the meal planner uses the deterministic heuristic planner.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Required when AI_PROVIDER=openai (no default is assumed).
OPENAI_MODEL=

# ---- Retailers (optional) --------------------------------------------------
# Instacart Developer Platform key (https://docs.instacart.com/developer_platform_api/).
# Leave empty to disable the Instacart shopping-list handoff.
INSTACART_API_KEY=
# development -> https://connect.dev.instacart.tools, production -> https://connect.instacart.com
INSTACART_ENV=development

# ---- Admin ports (bound to 127.0.0.1 only) ----------------------------------
GROCY_ADMIN_PORT=9283
MEALIE_ADMIN_PORT=9925
GMS_ADMIN_PORT=3001
N8N_ADMIN_PORT=5678
HUB_LOCAL_PORT=3000
